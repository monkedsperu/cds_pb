# Copia este archivo como .env y edítalo. No lo subas a ningún repositorio.

# Contraseña del administrador. Puede agregar/eliminar contraseñas de usuarios
# y cambiar el token de Cruz del Sur desde ⚙ Configuración.
ADMIN_PASSWORD=cambia-esta-clave-de-admin

# Contraseñas de usuarios, separadas por coma (el admin las gestiona desde la página).
APP_PASSWORDS=

# Token de Cruz del Sur (valor del encabezado "authorization").
# El admin también puede pegarlo desde ⚙ Configuración.
CDS_TOKEN=
